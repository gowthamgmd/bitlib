# BITSathy Central Library - Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/bitlib

# JWT Secret for session tokens (change this in production!)
JWT_SECRET=bit_central_library_super_secret_jwt_key_2026

# Google OAuth 2.0 Credentials
# 1. Go to https://console.cloud.google.com
# 2. Create a project (or select an existing one)
# 3. Navigate to APIs & Services > Credentials
# 4. Create OAuth 2.0 Client ID (Web application)
# 5. Add http://localhost:5173 to "Authorized JavaScript origins"
# 6. Copy the Client ID below
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE.apps.googleusercontent.com
